+package net.osmand.router;
+
+import net.osmand.Location;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Bicycle infrastructure and guidance from one BRouter GeoJSON response. */
+public final class BicycleRoute {
+	public enum Facility { MAPPED, ORDINARY, UNKNOWN }
+
+	public record Point(double latitude, double longitude, double elevation) {}
+	public record Hint(int index, String turn, int angle, int secondsToNext) {}
+
+	private final List<Point> points = new ArrayList<>();
+	private final List<Hint> hints = new ArrayList<>();
+	private final List<Facility> incoming = new ArrayList<>();
+
+	public BicycleRoute(String response) throws JSONException {
+		JSONObject feature = new JSONObject(response).getJSONArray("features").getJSONObject(0);
+		JSONArray coordinates = feature.getJSONObject("geometry").getJSONArray("coordinates");
+		for (int i = 0; i < coordinates.length(); i++) {
+			JSONArray coordinate = coordinates.getJSONArray(i);
+			points.add(new Point(coordinate.getDouble(1), coordinate.getDouble(0), coordinate.optDouble(2)));
+			incoming.add(Facility.UNKNOWN);
+		}
+		if (points.size() < 2) {
+			throw new JSONException("BRouter route has fewer than two points");
+		}
+		JSONObject properties = feature.getJSONObject("properties");
+		readFacilities(properties.optJSONArray("messages"));
+		readHints(properties);
+	}
+
+	public List<Point> getPoints() {
+		return points;
+	}
+
+	public List<Hint> getHints() {
+		return hints;
+	}
+
+	private void readFacilities(JSONArray rows) throws JSONException {
+		if (rows == null || rows.length() < 2) {
+			return;
+		}
+		Map<String, Integer> columns = new HashMap<>();
+		JSONArray header = rows.getJSONArray(0);
+		for (int i = 0; i < header.length(); i++) {
+			columns.put(header.getString(i), i);
+		}
+		Integer lon = columns.get("Longitude");
+		Integer lat = columns.get("Latitude");
+		Integer tags = columns.get("WayTags");
+		if (lon == null || lat == null || tags == null) {
+			return;
+		}
+		int start = 0;
+		for (int i = 1; i < rows.length(); i++) {
+			JSONArray row = rows.getJSONArray(i);
+			int endLatitude = row.getInt(lat);
+			int endLongitude = row.getInt(lon);
+			int end = start + 1;
+			while (end < points.size()) {
+				Point point = points.get(end);
+				if (Math.round(point.latitude * 1e6) == endLatitude
+						&& Math.round(point.longitude * 1e6) == endLongitude) {
+					break;
+				}
+				end++;
+			}
+			if (end >= points.size()) {
+				// A missing boundary makes the remaining alignment ambiguous.
+				break;
+			}
+			Facility facility = classify(row.getString(tags));
+			for (int j = start + 1; j <= end; j++) {
+				incoming.set(j, facility);
+			}
+			start = end;
+		}
+	}
+
+	private Facility classify(String rawTags) {
+		Map<String, String> tags = new HashMap<>();
+		for (String entry : rawTags.split(" ")) {
+			int separator = entry.indexOf('=');
+			if (separator > 0) {
+				tags.put(entry.substring(0, separator), entry.substring(separator + 1));
+			}
+		}
+		String highway = tags.get("highway");
+		if ("cycleway".equals(highway)
+				|| (("path".equals(highway) || "footway".equals(highway)) && "designated".equals(tags.get("bicycle")))
+				|| isBicycleStreet(tags.get("bicycle_road")) || isBicycleStreet(tags.get("cyclestreet"))) {
+			return Facility.MAPPED;
+		}
+		boolean reverse = "yes".equals(tags.get("reversedirection"));
+		boolean explicitlyOrdinary = false;
+		for (String side : new String[] {"", ":both", ":left", ":right"}) {
+			String type = tags.get("cycleway" + side);
+			String direction = tags.get("cycleway" + side + ":oneway");
+			boolean accessible = switch (direction == null ? "" : direction) {
+				case "no" -> true;
+				case "yes", "1" -> !reverse;
+				case "-1" -> reverse;
+				default -> side.isEmpty() || ":both".equals(side) || (reverse == ":left".equals(side));
+			};
+			if (accessible && ("track".equals(type) || "lane".equals(type))) {
+				return Facility.MAPPED;
+			}
+			explicitlyOrdinary |= accessible && ("no".equals(type) || "shared_lane".equals(type)
+					|| "share_busway".equals(type));
+		}
+		return explicitlyOrdinary ? Facility.ORDINARY : Facility.UNKNOWN;
+	}
+
+	private boolean isBicycleStreet(String value) {
+		return "yes".equals(value) || "designated".equals(value);
+	}
+
+	private void readHints(JSONObject properties) throws JSONException {
+		JSONArray voiceHints = properties.optJSONArray("voicehints");
+		JSONArray times = properties.optJSONArray("times");
+		int last = points.size() - 1;
+		List<Integer> indexes = new ArrayList<>();
+		List<String> turns = new ArrayList<>();
+		List<Integer> angles = new ArrayList<>();
+		indexes.add(0);
+		turns.add("C");
+		angles.add(0);
+		if (voiceHints != null) {
+			for (int i = 0; i < voiceHints.length(); i++) {
+				JSONArray hint = voiceHints.getJSONArray(i);
+				int index = hint.getInt(0);
+				String turn = switch (hint.getInt(1)) {
+					case 2 -> "TL";
+					case 3 -> "TSLL";
+					case 4 -> "TSHL";
+					case 5 -> "TR";
+					case 6 -> "TSLR";
+					case 7 -> "TSHR";
+					case 8, 17 -> "KL";
+					case 9, 18 -> "KR";
+					case 10, 15 -> "TU";
+					case 11 -> "TRU";
+					case 12 -> "OFFR";
+					case 13 -> "RNDB" + Math.abs(hint.getInt(2));
+					case 14 -> "RNLB" + Math.abs(hint.getInt(2));
+					default -> "C";
+				};
+				if (index > indexes.get(indexes.size() - 1) && index < last) {
+					indexes.add(index);
+					turns.add(turn);
+					angles.add(hint.getInt(4));
+				}
+			}
+		}
+		indexes.add(last);
+		turns.add("C");
+		angles.add(0);
+		for (int i = 0; i < indexes.size(); i++) {
+			int index = indexes.get(i);
+			int seconds = times != null && i + 1 < indexes.size()
+					? (int) (Math.round(times.optDouble(indexes.get(i + 1), 0)) - Math.round(times.optDouble(index, 0)))
+					: 0;
+			hints.add(new Hint(index, turns.get(i), angles.get(i), Math.max(0, seconds)));
+		}
+	}
+
+	public Coverage coverage(List<Location> source, List<Location> route) {
+		Map<Location, Facility> byEndpoint = new IdentityHashMap<>();
+		for (int i = 1; i < source.size(); i++) {
+			byEndpoint.put(source.get(i), incoming.get(i));
+		}
+		List<Facility> facilities = new ArrayList<>();
+		float total = 0;
+		float mapped = 0;
+		float unknown = 0;
+		for (int i = 1; i < route.size(); i++) {
+			Facility facility = byEndpoint.get(route.get(i));
+			if (facility == null) {
+				facility = Facility.UNKNOWN;
+			}
+			facilities.add(facility);
+			float distance = route.get(i - 1).distanceTo(route.get(i));
+			total += distance;
+			if (facility == Facility.MAPPED) {
+				mapped += distance;
+			} else if (facility == Facility.UNKNOWN) {
+				unknown += distance;
+			}
+		}
+		return new Coverage(Collections.unmodifiableList(facilities), mapped, unknown, total);
+	}
+
+	public record Coverage(List<Facility> facilities, float mapped, float unknown, float total) {}
+}

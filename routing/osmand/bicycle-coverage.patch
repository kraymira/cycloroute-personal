+	private InputStream openBRouterResponse(String response) throws IOException {
+		if (response.startsWith("ejY0")) {
+			byte[] compressed = Base64.decode(response, Base64.DEFAULT);
+			return new GZIPInputStream(new ByteArrayInputStream(compressed, 3, compressed.length - 3));
+		}
+		return new ByteArrayInputStream(response.getBytes(StandardCharsets.UTF_8));
+	}
+
+	private RouteCalculationResult buildBicycleRoute(String response, RouteCalculationParams params) throws JSONException {
+		BicycleRoute bicycleRoute = new BicycleRoute(response);
+		GPXFile gpx = new GPXFile("OsmAndRouter");
+		TrkSegment segment = new TrkSegment();
+		GPXUtilities.Track track = new GPXUtilities.Track();
+		track.segments.add(segment);
+		gpx.tracks.add(track);
+		for (BicycleRoute.Point point : bicycleRoute.getPoints()) {
+			WptPt waypoint = new WptPt();
+			waypoint.lat = point.latitude();
+			waypoint.lon = point.longitude();
+			waypoint.ele = point.elevation();
+			segment.points.add(waypoint);
+		}
+		Route route = new Route();
+		gpx.routes.add(route);
+		for (BicycleRoute.Hint hint : bicycleRoute.getHints()) {
+			WptPt turn = new WptPt(segment.points.get(hint.index()));
+			turn.desc = RouteCalculationResult.toString(TurnType.fromString(hint.turn(), params.leftSide), params.ctx, false);
+			Map<String, String> extensions = turn.getExtensionsToWrite();
+			extensions.put("offset", Integer.toString(hint.index()));
+			extensions.put("turn", hint.turn());
+			extensions.put("turn-angle", Integer.toString(hint.angle()));
+			extensions.put("time", Integer.toString(hint.secondsToNext()));
+			route.points.add(turn);
+		}
+		List<Location> locations = new ArrayList<>();
+		List<RouteDirectionInfo> directions = parseOsmAndGPXRoute(locations, SharedUtil.kGpxFile(gpx),
+				new ArrayList<>(), true, params.leftSide, params.mode.getDefaultSpeed(), -1);
+		return new RouteCalculationResult(locations, directions, params, null, directions == null, bicycleRoute);
+	}
